# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. (.env는 커밋되지 않는다)
#   cp .env.example .env
# 실행:
#   set -a && source .env && set +a && ./gradlew bootRun

# Anthropic Claude API 키 (기사 요약·분류에 사용)
ANTHROPIC_API_KEY=

# 텔레그램 봇 토큰 — @BotFather에서 발급
TELEGRAM_BOT_TOKEN=

# 요약을 받을 대화방 ID — @userinfobot에게 말을 걸면 확인 가능
TELEGRAM_CHAT_ID=
